# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/smart_prescription

# Auth
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Anthropic Claude (AI features 1 & 2)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# Twilio WhatsApp (Sandbox for dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# HuggingFace Inference API (Whisper voice-to-text)
HF_API_TOKEN=
HF_WHISPER_MODEL=openai/whisper-small

# Public base URL where generated PDFs are served (used in WhatsApp media link)
PUBLIC_BASE_URL=http://localhost:5000
